{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/parceria",
      "destination": "/parceria/index.html"
    },
    {
      "source": "/treinamento-loja/dono-da-loja",
      "destination": "/treinamento-loja/dono-da-loja/index.html"
    },
    {
      "source": "/treinamento-loja/dono-da-loja/",
      "destination": "/treinamento-loja/dono-da-loja/index.html"
    }
  ]
}
