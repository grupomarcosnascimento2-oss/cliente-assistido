{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/parceria",
      "destination": "/parceria/index.html"
    },
    {
      "source": "/treinamento-loja/dono-da-loja",
      "destination": "/treinamento-loja/dono-da-loja/index.html"
    },
    {
      "source": "/treinamento-loja/dono-da-loja/",
      "destination": "/treinamento-loja/dono-da-loja/index.html"
    },
    {
      "source": "/fraternidade-viva",
      "destination": "/fraternidade-viva/index.html"
    },
    {
      "source": "/fraternidade-viva/",
      "destination": "/fraternidade-viva/index.html"
    },
    {
      "source": "/fraternidade-viva/nova",
      "destination": "/fraternidade-viva/nova/index.html"
    },
    {
      "source": "/fraternidade-viva/nova/",
      "destination": "/fraternidade-viva/nova/index.html"
    },
    {
      "source": "/fraternidade-viva/opcao2",
      "destination": "/fraternidade-viva/opcao2/index.html"
    },
    {
      "source": "/fraternidade-viva/opcao2/",
      "destination": "/fraternidade-viva/opcao2/index.html"
    },
    {
      "source": "/fraternidade-viva/obrigado",
      "destination": "/fraternidade-viva/obrigado/index.html"
    },
    {
      "source": "/fraternidade-viva/obrigado/",
      "destination": "/fraternidade-viva/obrigado/index.html"
    },
    {
      "source": "/fraternidade-viva/opcao3",
      "destination": "/fraternidade-viva/opcao3/index.html"
    },
    {
      "source": "/fraternidade-viva/opcao3/",
      "destination": "/fraternidade-viva/opcao3/index.html"
    }
  ]
}
